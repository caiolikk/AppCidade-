# PostgreSQL / PostGIS (desenvolvimento local)
POSTGRES_USER=cidade
POSTGRES_PASSWORD=cidade
POSTGRES_DB=cidade_plus
POSTGRES_PORT=5432

# Prisma (usado a partir da ETAPA 3)
DATABASE_URL=postgresql://cidade:cidade@localhost:5432/cidade_plus?schema=public

# API Fastify (ETAPA 4)
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3333

# Auth (ETAPA 5) — trocar em produção
JWT_SECRET=cidade-plus-dev-jwt-secret
JWT_EXPIRES_IN=15m

# Ocorrências (D-018) — regra "só criar dentro do bairro residencial".
# Desativada temporariamente. Use true para reativar.
OCCURRENCE_GEOFENCE_ENABLED=false

# Cloudinary (ETAPA 8) — não colocar secrets no app mobile
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed local (opcional)
SEED_ADMIN_PASSWORD=admin1234
SEED_MANAGER_PASSWORD=gestor1234

# Mobile (ETAPA 10) — opcional. Sem isso, o Expo usa o IP do Metro + porta 3333.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3333

# ---------------------------------------------------------------------------------------
# PRODUÇÃO (plano hospedagem-e-deploy). NÃO use este arquivo em produção: os valores ficam
# só no painel da plataforma (Railway). Diferenças em relação ao desenvolvimento:
#   NODE_ENV=production
#   PORT                         informado pela plataforma (tem prioridade sobre API_PORT)
#   DATABASE_URL                 Neon, conexão DIRETA (sem "-pooler"), com
#                                sslmode=require&connect_timeout=15
#   JWT_SECRET                   aleatório e longo, exclusivo de produção
#   CLOUDINARY_*                 OBRIGATÓRIAS em produção (a API não sobe sem elas)
#   UPLOADS_LOCAL_IN_PRODUCTION  só "true" com disco persistente (VPS/volume); padrão false
#   SEED_ADMIN_PASSWORD / SEED_MANAGER_PASSWORD   obrigatórias (12+ caracteres) para o seed
#                                em produção. Cada execução do seed REGRAVA essas senhas.
