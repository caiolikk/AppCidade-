{
  "expo": {
    "name": "Cidade+",
    "slug": "cidade-plus",
    "version": "0.0.1",
    "scheme": "cidadeplus",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E6B4F"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E6B4F"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Cidade+ precisa da galeria para anexar a evidência da ocorrência.",
          "cameraPermission": "O Cidade+ precisa da câmera para fotografar a evidência da ocorrência."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Cidade+ usa sua localização para registrar a ocorrência no seu bairro."
        }
      ]
    ]
  }
}
