# PostgreSQL / PostGIS (desenvolvimento local)
POSTGRES_USER=cidade
POSTGRES_PASSWORD=cidade
POSTGRES_DB=cidade_plus
POSTGRES_PORT=5432

# Prisma (usado a partir da ETAPA 3)
DATABASE_URL=postgresql://cidade:cidade@localhost:5432/cidade_plus?schema=public

# API Fastify (ETAPA 4)
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3333

# Auth (ETAPA 5) — trocar em produção
JWT_SECRET=cidade-plus-dev-jwt-secret
JWT_EXPIRES_IN=15m

# Cloudinary (ETAPA 8) — não colocar secrets no app mobile
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed local (opcional)
SEED_ADMIN_PASSWORD=admin1234
SEED_MANAGER_PASSWORD=gestor1234

# Mobile (ETAPA 10) — opcional. Sem isso, o Expo usa o IP do Metro + porta 3333.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3333

# Google Maps (ETAPA 11) — chave para o Google Maps SDK no Android.
# Se vazia, o Cidade+ utiliza a camada Mapbox streets-v12 ou tiles abertos via UrlTile automaticamente.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Mapbox (estilo streets-v12 idêntico ao WWork)
# EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
