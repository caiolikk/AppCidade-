{
  "name": "cidade-plus",
  "version": "0.0.1",
  "private": true,
  "description": "Cidade+ — plataforma mobile-first de participação cidadã e manutenção urbana (Santos/SP)",
  "workspaces": [
    "apps/api",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "npm run dev -w @cidade-plus/api",
    "dev:mobile": "npm run dev -w @cidade-plus/mobile",
    "dev:mobile:tunnel": "npm run dev:tunnel -w @cidade-plus/mobile",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @cidade-plus/api"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "packageManager": "npm@10",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "prisma": "^6.14.0",
    "tsx": "^4.23.12"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "@react-native/codegen": "0.86.3",
    "@react-native/babel-plugin-codegen": "0.86.3",
    "@react-native/babel-preset": "0.86.3"
  }
}
