# Variáveis do app mobile. O Expo carrega o .env desta pasta (apps/mobile), não o da raiz.
# Copie para apps/mobile/.env. Nunca coloque secrets aqui: EXPO_PUBLIC_* vai para dentro do app.

# Opcional. Sem isso, o app usa o IP do Metro + porta 3333 (funciona no Wi-Fi local).
# Obrigatório em builds preview/produção (não há Metro para descobrir o IP).
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3333

# Necessária para o mapa no Android fora do Expo Go. Só é lida no momento do build.
# No EAS: eas env:create --name GOOGLE_MAPS_ANDROID_API_KEY --environment development (e preview/production)
# GOOGLE_MAPS_ANDROID_API_KEY=
