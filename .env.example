# PostgreSQL / PostGIS (desenvolvimento local)
POSTGRES_USER=cidade
POSTGRES_PASSWORD=cidade
POSTGRES_DB=cidade_plus
POSTGRES_PORT=5432

# Prisma (usado a partir da ETAPA 3)
DATABASE_URL=postgresql://cidade:cidade@localhost:5432/cidade_plus?schema=public

# API Fastify (ETAPA 4)
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3333

# Auth (ETAPA 5) — trocar em produção
JWT_SECRET=cidade-plus-dev-jwt-secret
JWT_EXPIRES_IN=15m

# Seed local (opcional)
SEED_ADMIN_PASSWORD=admin1234
SEED_MANAGER_PASSWORD=gestor1234
